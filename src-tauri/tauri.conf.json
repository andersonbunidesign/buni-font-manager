{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buni Font Manager",
  "version": "../package.json",
  "identifier": "com.andersonbunidesign.fontmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Buni Font Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Buni Font Manager/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Anderson Santos",
    "copyright": "Anderson Santos",
    "category": "Graphics and Design",
    "shortDescription": "Font manager for Illustrator and Affinity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
